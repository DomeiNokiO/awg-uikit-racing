{
  "name": "AWG-UIKIT-RACING",
  "version": "1.0.0",
  "author": "AWGNET-RACING & AGENT AI TEAM",
  "license": "MIT",
  "prefix": "awg-",
  "color": {
    "ink": { "light": "#0f172a", "dark": "#e2e8f0" },
    "ink2": { "light": "#475569", "dark": "#94a3b8" },
    "ink3": { "light": "#94a3b8", "dark": "#64748b" },
    "line": { "light": "#e2e8f0", "dark": "#1e293b" },
    "bg": { "light": "#f1f5f9", "dark": "#0b1220" },
    "surface": { "light": "#ffffff", "dark": "#0f172a" },
    "surface2": { "light": "#f8fafc", "dark": "#131d33" },
    "brand": { "value": "#2563eb", "hover": "#1d4ed8", "soft": "#eff6ff", "grad": "linear-gradient(135deg,#3b82f6,#6366f1)" },
    "accent": "#6366f1",
    "success": { "value": "#16a34a", "soft": "#f0fdf4" },
    "warning": { "value": "#d97706", "soft": "#fffbeb" },
    "danger": { "value": "#dc2626", "soft": "#fef2f2" },
    "info": { "value": "#0891b2", "soft": "#ecfeff" },
    "sidebar": { "bg": "#0f172a", "ink": "#cbd5e1", "line": "rgba(148,163,184,.15)" }
  },
  "typography": {
    "fontFamily": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "fontMono": "ui-monospace, 'SF Mono', monospace",
    "fontSizeBase": ".925rem",
    "headingWeight": 700,
    "numberWeight": 800,
    "letterSpacingTight": "-.02em"
  },
  "radius": { "sm": "10px", "md": "14px", "lg": "18px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(15,23,42,.05)",
    "md": "0 1px 2px rgba(15,23,42,.05), 0 8px 24px -12px rgba(15,23,42,.12)",
    "lg": "0 24px 64px -16px rgba(15,23,42,.35)"
  },
  "sizing": { "sidebar": "264px", "topbar": "68px", "contentMax": "1440px", "touchMin": "44px" },
  "motion": { "fast": ".16s ease", "drawer": ".22s ease" },
  "breakpoints": { "xs": "576px", "md": "992px", "lg": "1200px" },
  "components": {
    "prefixClass": "awg-",
    "prefixData": "data-awg-",
    "cssVarPrefix": "--awg-"
  }
}
